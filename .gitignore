# Agent files. The project layer `<root>/.agents/` holds committable project
# configuration; only this repository's local glue is ignored here. Product-local
# files (worktree/, plans/, settings.local.json, hooks.local.json) are excluded
# through the Git common-dir `info/exclude` at runtime, not in this file.
.agents/hooks.json
.agents/skills/specgit-native/
.claude
.husky/
.qoder

# CI watcher test for the local .agents hook scaffolding; kept local with its tool
/packages/graphagent/test/hook/repo-ci-watcher.test.ts

# Local-only agent tooling: SpecGit integration and MCP plugin resources.
# These are per-checkout configuration, instructions, caches and workspace
# state regenerated by the tools; they must never enter the repository.
# SpecGit's .agents, .claude, .specgit.yaml, spec_git, Serena's .serena,
# and codebase-memory/MCP state are covered here or above.
/CLAUDE.md
**/.mcp.json
**/.mcp/
**/.codebase-memory/
**/.codebase-memory-mcp/

# graphagent local workflow state
.agents/dag-init.json

# Retained private migration evidence and legacy delivery records
/spec_git/
/.local/state/
/.local/cache/

# SpecGit 2.5 declaration: per-checkout local configuration (also excluded by `specgit init`)
/.specgit.yaml

# Public tree policy: keep project code, current user-facing documentation, and
# AGENTS.md. Dated audits, evidence, plans, prototypes, and obsolete specs stay
# local. The negations below are the only top-level docs kept by default.
/docs/*.md
!/docs/architecture.md
!/docs/compaction-retry.md
!/docs/dag-file-artifacts-and-recovery.md
!/docs/功能清单.md
/docs/agents/
/docs/context-folding/evidence/
/docs/continuation-2026-09-20/*.md
/docs/continuation-2026-09-20/s09/*.md
/docs/continuation-2026-09-20/s09/*.json
/docs/evidence/
/docs/examples/*
!/docs/examples/internal-llm-aggregator.jsonc
/docs/findings/

