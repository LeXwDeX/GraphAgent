                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "result_protocol": {
                      "description": "Result capture protocol. New workflows default to final_response; submit_result is legacy compatibility.",
                      "enum": [
                        "final_response",
                        "submit_result",
                      ],
