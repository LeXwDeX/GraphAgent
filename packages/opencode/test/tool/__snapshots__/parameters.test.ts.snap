                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "fan_out": {
                            "description": "(implementation writers) Direct dependency whose output.packages [{ id, instruction, write_set }] fans this writer out when it becomes ready: two or more disjoint packages run as parallel writers <id>--<package-id> and this node becomes their implementation aggregator under the same id; fewer packages, or an unsafe shape, run this writer unchanged",
                            "type": "string",
                          },
                          "id": {
                            "description": "Unique node identifier, used in depends_on",
