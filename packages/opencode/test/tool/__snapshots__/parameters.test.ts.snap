                      "description": "Cumulative node cap across the workflow lifetime. Default: 100",
                      "type": "number",
                    },
                    "name": {
                      "description": "Workflow name",
                      "type": "string",
                    },
                    "node_defaults": {
                      "description": "Defaults inherited by nodes that omit required, worker_config, or report_to_parent",
                      "properties": {
