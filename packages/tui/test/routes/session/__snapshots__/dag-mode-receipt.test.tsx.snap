// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`renders the on receipt in zh-CN 1`] = `
"                                                                                                    
  ┃                                                                                                 
  ┃  DAG 模式已开启（本会话，自下一次请求起生效）；token 消耗通常成倍增加；并发上限 4（所有会话共   
  ┃  享）、单工作流节点上限 32、token 预算 200000；关闭：/dag-mode off 或 ctrl+x d                  
  ┃                                                                                                 
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
  ┃                                                                                                 
  ┃                                                                                                 
  ┃                                                                                                 
  ┃                                                                                                 
  ╹▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀  
                                                                                 agents   commands  
                                                                                                    
"
`;

exports[`renders the on receipt in en 1`] = `
