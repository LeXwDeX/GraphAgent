exports[`tool parameters JSON Schema (wire shape) task 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "description": "Set to "cancel" together with task_id to cancel one of this session's background tasks. Omit for a normal task run. Only background tasks can be cancelled here; a foreground task is cancelled from the parent session.",
      "enum": [
        "cancel",
      ],
      "type": "string",
    },
    "background": {
      "description": "Run without waiting. Use only for independent, long-running work whose result you do not need for your next step (see "Choosing foreground or background"). You will be notified when it finishes.",
      "type": "boolean",
    },
    "command": {
      "description": "The command that triggered this task",
      "type": "string",
    },
    "description": {
      "description": "A short (3-5 words) description of the task; required unless action is cancel",
      "type": "string",
    },
    "prompt": {
      "description": "The task for the agent to perform; required unless action is cancel",
      "type": "string",
    },
    "subagent_type": {
      "description": "The type of specialized agent to use for this task; required unless action is cancel",
      "type": "string",
    },
    "task_id": {
      "description": "With action "cancel": the background task to cancel. Otherwise set only to resume a previous task (pass a prior task_id and the task continues the same subagent session instead of creating a fresh one)",
      "type": "string",
    },
  },
  "type": "object",
}
`;

