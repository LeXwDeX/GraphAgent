            "action": {
              "enum": [
                "send",
              ],
              "type": "string",
            },
            "attempt_id": {
              "description": "Exact execution attempt returned by observe; retries never retarget a newer attempt.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
            },
            "content": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string",
            },
            "idempotency_key": {
