            "workflow_id",
            "idempotency_key",
            "content",
            "recipient",
            "node_id",
            "attempt_id",
          ],
          "type": "object",
        },
        {
          "properties": {
            "action": {
              "enum": [
                "send",
              ],
              "type": "string",
            },
            "content": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string",
            },
            "idempotency_key": {
              "description": "Stable retry key. Reuse only for the identical destination and content.",
              "maxLength": 128,
              "minLength": 1,
              "type": "string",
            },
            "recipient": {
              "enum": [
                "parent",
              ],
              "type": "string",
            },
            "reply_to": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
            },
            "workflow_id": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "action",
            "workflow_id",
            "idempotency_key",
            "content",
            "recipient",
          ],
          "type": "object",
        },
        {
          "properties": {
            "action": {
              "enum": [
                "receive",
              ],
              "type": "string",
            },
            "after_sequence": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "limit": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer",
            },
