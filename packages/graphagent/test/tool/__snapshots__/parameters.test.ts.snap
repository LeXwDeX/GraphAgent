exports[`tool parameters JSON Schema (wire shape) read 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "charOffset": {
      "description": "Character offset within each displayed line (1-indexed); combine it with maxLineLength to continue a long line past the character cap",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
    "filePath": {
      "description": "Path to the file or directory to read; relative paths resolve from the project directory",
      "type": "string",
    },
    "limit": {
      "description": "The maximum number of lines or directory entries to read (positive integer, defaults to 2000)",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
    "maxLineLength": {
      "description": "Maximum characters to show from each line (defaults to 2000, capped at 50000); use it to continue a truncated long line",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
    "offset": {
      "description": "The line number or directory entry to start reading from (1-indexed positive integer)",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
    "page": {
      "description": "Read one page of the file (200 lines, or limit when set): page 1 is the start, -1 is the last page, -2 the page before. Cannot be combined with offset",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
  },
  "required": [
    "filePath",
  ],
  "type": "object",
}
`;

