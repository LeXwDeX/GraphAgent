exports[`graphagent CLI help-text snapshots every documented command emits stable help text: graphagent db --help 1`] = `
"graphagent db

database tools

Commands:
  graphagent db [query]     open an interactive sqlite3 shell or run a query               [default]
  graphagent db path        print the database path
  graphagent db vacuum      convert a database file to full auto_vacuum (FULL -> VACUUM -> truncate
                            WAL)

Positionals:
  query  SQL query to execute                                                               [string]

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --format      Output format                 [string] [choices: "json", "tsv"] [default: "tsv"]"
`;

