// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`graphagent CLI help-text snapshots every documented command emits stable help text: graphagent mcp --help 1`] = `
"graphagent mcp

manage MCP (Model Context Protocol) servers

Commands:
  graphagent mcp add [name]     add an MCP server
  graphagent mcp list           list MCP servers and their status                      [aliases: ls]
  graphagent mcp auth [name]    authenticate with an OAuth-enabled MCP server
  graphagent mcp logout [name]  remove OAuth credentials for an MCP server
  graphagent mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]"
`;

exports[`graphagent CLI help-text snapshots every documented command emits stable help text: graphagent run --help 1`] = `
"graphagent run [message..]

run graphagent with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help                          show help                                            [boolean]
  -v, --version                       show version number                                  [boolean]
      --print-logs                    print logs to stderr                                 [boolean]
      --log-level                     log level [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --command                       the command to run, use message for args              [string]
  -c, --continue                      continue the last session                            [boolean]
  -s, --session                       session id to continue                                [string]
      --fork                          fork the session before continuing (requires --continue or
                                      --session)                                           [boolean]
  -m, --model                         model to use in the format of provider/model          [string]
      --agent                         agent to use                                          [string]
      --format                        format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file                          file(s) to attach to message                           [array]
      --title                         title for the session (uses truncated prompt if no value
                                      provided)                                             [string]
      --dir                           directory to run in                                   [string]
      --variant                       model variant (provider-specific reasoning effort, e.g., high,
                                      max, minimal)                                         [string]
      --thinking                      show thinking blocks                                 [boolean]
      --dangerously-skip-permissions  auto-approve permissions that are not explicitly denied
                                      (dangerous!)                        [boolean] [default: false]
      --init                          run Setup hooks for one-time initialization, then continue the
                                      run                                 [boolean] [default: false]
      --maintenance                   run Setup hooks for maintenance, then continue the run
                                                                          [boolean] [default: false]
      --init-only                     run Setup and startup SessionStart hooks, then exit without
                                      starting a conversation             [boolean] [default: false]"
`;

exports[`graphagent CLI help-text snapshots every documented command emits stable help text: graphagent debug --help 1`] = `
"graphagent debug

debugging and troubleshooting tools

Commands:
  graphagent debug config        show resolved configuration
  graphagent debug lsp           LSP debugging utilities
  graphagent debug rg            ripgrep debugging utilities
  graphagent debug file          file system debugging utilities
  graphagent debug scrap         list all known projects
  graphagent debug skill         list all available skills
  graphagent debug snapshot      snapshot debugging utilities
  graphagent debug startup       print startup timing
  graphagent debug agent <name>  show agent configuration details
  graphagent debug info          show debug information
  graphagent debug paths         show global paths (data, config, cache, state)
  graphagent debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]"
`;

