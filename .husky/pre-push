#!/bin/sh
set -e

# Enforce the SpecGit checkpoint only in locally initialized checkouts.
# The guard consumes Git's pre-push ref lines from stdin; capture them so the
# later checks still see the same stdin.
if [ -f .specgit.yaml ]; then
  if command -v specgit >/dev/null 2>&1; then
    specgit_input=$(mktemp "${TMPDIR:-/tmp}/specgit-pre-push.XXXXXX") || exit 1
    trap 'rm -f "$specgit_input"' EXIT HUP INT TERM
    cat > "$specgit_input"
    specgit guard --stage pre-push < "$specgit_input"
    exec < "$specgit_input"
    rm -f "$specgit_input"
    trap - EXIT HUP INT TERM
  else
    echo "warning: .specgit.yaml exists but specgit is not on PATH; skipping SpecGit guard" >&2
  fi
fi

node script/toolchain.mjs check --go
sh .husky/run-typecheck
